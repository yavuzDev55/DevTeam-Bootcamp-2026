// Bu dosyanın generator ve datasource blokları hazır geliyor.
// Modelleri siz yazacaksınız — ODEV-3.md'deki veri modeli bölümüne bakın.

generator client {
  // DİKKAT: "prisma-client" (tire yok) generator'ı YALNIZCA TypeScript üretir.
  // Düz JavaScript projesinde import anında patlar. Bu satırı değiştirmeyin.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Bağlantı adresi burada değil, prisma.config.js dosyasında.
}

